# 服务端口（HTTP）
PORT=8080

# HTTPS 端口（手机端使用 Web Crypto 需要 HTTPS）
HTTPS_PORT=3443

# 上传目录（默认 ./uploads）
UPLOAD_DIR=./uploads

# 最大文件大小（字节，5GB）
MAX_FILE_SIZE=5368709120

# CORS 来源（生产环境建议设为你的域名）
CORS_ORIGIN=*

# 公网地址（有域名或使用反代时设置，例如 https://dropshare.example.com）
# 留空则自动使用服务器 IP
PUBLIC_URL=

# 是否在反向代理（Nginx/Caddy）后方（设为 true 后获取真实客户端 IP）
TRUST_PROXY=false

# 上传速率限制：每 15 分钟最大上传次数
UPLOAD_MAX=30

# 下载速率限制：每 15 分钟最大下载次数
DOWNLOAD_MAX=100

# NODE_ENV
NODE_ENV=production
